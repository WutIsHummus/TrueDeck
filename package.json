{
  "name": "truedeck",
  "version": "0.3.0",
  "description": "Terminal-first multi-agent coding deck — Grok, Codex, Cursor, Claude with automatic memory and Ctrl+Shift shortcuts.",
  "main": "./out/main/index.js",
  "author": "TrueDeck Contributors",
  "license": "MIT",
  "homepage": "https://github.com/WutIsHummus/TrueDeck",
  "repository": {
    "type": "git",
    "url": "https://github.com/WutIsHummus/TrueDeck.git"
  },
  "keywords": [
    "ai",
    "agents",
    "coding",
    "terminal",
    "electron",
    "codex",
    "claude",
    "grok",
    "cursor",
    "memory"
  ],
  "scripts": {
    "start": "electron-vite dev",
    "studio": "electron-vite dev",
    "tui": "tsx tui/index.ts",
    "gui": "electron-vite dev",
    "dev": "electron-vite dev",
    "dev:tui": "tsx tui/index.ts",
    "dev:gui": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "bin": {
    "truedeck": "./bin/truedeck.js"
  },
  "dependencies": {
    "@types/blessed": "^0.1.27",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "blessed": "^0.1.81",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.1.0",
    "xterm": "^5.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vite": "^5.4.14"
  },
  "build": {
    "appId": "dev.truedeck.app",
    "productName": "TrueDeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
